{
  "name": "ottercode",
  "version": "0.3.0",
  "description": "A local, inspectable coding agent for your terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ottercode": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "ottercode.config.example.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:terminal": "npm run build && node scripts/terminal-smoke.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "cli-highlight": "^2.1.11",
    "diff": "^8.0.2",
    "ignore": "^7.0.5",
    "ink": "^8.0.0",
    "js-tiktoken": "^1.0.21",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.3.0",
    "strip-ansi": "^7.1.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
